{
  "name": "PickupLocation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Pickup location display name"
    },
    "address": {
      "type": "string",
      "description": "Full address or description"
    },
    "location": {
      "type": "string",
      "enum": [
        "ixtapa_zihuatanejo",
        "acapulco"
      ],
      "description": "Which destination this belongs to"
    },
    "applicable_boats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Boat names this pickup location applies to (empty = all boats)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes for crew or guests"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Show in booking flow"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "location"
  ]
}