{
  "name": "EngineDocument",
  "type": "object",
  "properties": {
    "folder_name": {
      "type": "string",
      "description": "Engine folder name (e.g., 'Twin Yamaha 150 (2017)')"
    },
    "boat_name": {
      "type": "string",
      "description": "Associated boat name"
    },
    "engine_config": {
      "type": "string",
      "enum": [
        "inboard",
        "outboard"
      ],
      "description": "Engine configuration type"
    },
    "manufacturer": {
      "type": "string",
      "description": "Engine manufacturer"
    },
    "model": {
      "type": "string",
      "description": "Engine model"
    },
    "year": {
      "type": "string",
      "description": "Engine year"
    },
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "category": {
      "type": "string",
      "enum": [
        "service_manual",
        "brochure",
        "parts_catalog",
        "troubleshooting",
        "spec_sheet",
        "boat_manual"
      ],
      "description": "Document category"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the document file"
    },
    "reference_url": {
      "type": "string",
      "description": "Source URL where document was found"
    },
    "selection_logic": {
      "type": "string",
      "description": "Why this document was selected by AI"
    },
    "description": {
      "type": "string",
      "description": "Document description"
    }
  },
  "required": [
    "folder_name",
    "boat_name",
    "title",
    "category",
    "file_url"
  ]
}